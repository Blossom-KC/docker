# PHP loader: default for x86-64; set to ixed.8.3-arm.lin on ARM machines.
IXED_LOADER=ixed.8.3.lin

# Run blossom-cron: 1 = enabled (default), 0 = disabled.
BLOSSOM_CRON_ENABLED=1

# Use vhost.conf for HTTP (the default), or vhost-letsencrypt.conf for managed HTTPS.
APACHE_VHOST=vhost.conf
# Required when APACHE_VHOST=vhost-letsencrypt.conf.
LE_DOMAIN=blossom.example.com
LE_EMAIL=admin@example.com
# Optional: use staging for testing (certificates will not be browser trusted).
# LE_CA=https://acme-staging-v02.api.letsencrypt.org/directory
